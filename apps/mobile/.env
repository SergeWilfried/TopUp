# Build-time configuration for the app. Expo inlines EXPO_PUBLIC_* into the
# bundle, so these are baked in at build time, not read at runtime.
#
# Committed because the API URL is public — it is in every request the app
# makes — and because leaving it unset silently produced a release APK pointing
# at http://localhost:8787, which on a handset means the handset itself. A build
# that cannot reach the backend is not obviously broken until someone installs
# it, so the working value is the default rather than something to remember.
#
# For local development, override in .env.local (gitignored, and takes
# precedence): EXPO_PUBLIC_API_URL=http://<your-lan-ip>:8787
EXPO_PUBLIC_API_URL=https://topup-api.studiobangre.workers.dev

# Where "Help & support" and "Contact support" go. WhatsApp wins when set
# (E.164 digits, no plus, e.g. 22670000000); otherwise the mail app opens.
# Replace the email with the real support address before release.
EXPO_PUBLIC_SUPPORT_EMAIL=support@tofee.app
EXPO_PUBLIC_SUPPORT_WHATSAPP=
